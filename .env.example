# Пример настроек. Скопируйте в .env и поменяйте значения.
# Файл .env в git не попадает (см. .gitignore).

# По умолчанию — SQLite: файл todo.db создастся автоматически, ставить ничего не нужно.
DATABASE_URL=sqlite:///./todo.db

# Если захотите вернуться на MySQL — закомментируйте строку выше и раскомментируйте ниже:
# DATABASE_URL=mysql+pymysql://todo_user:todo_pass@localhost:3306/todo_db?charset=utf8mb4

# Сгенерируйте свой: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_ENV
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
